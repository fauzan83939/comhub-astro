---
const steps = [
  { title: "Join the community", desc: "Hop into our channels — introduce yourself, no application needed." },
  { title: "Explore with COMI", desc: "Ask our AI guide about Rialo, current activities, or how ComHub works." },
  { title: "Jump into activities", desc: "Join a quest, a builder session, or just hang out and follow along." },
];
---
<section id="how-it-works">
  <div class="wrap">
    <div class="section-head">
      <h2>How to get involved</h2>
      <p>No gatekeeping — here's exactly how to start.</p>
    </div>
    <div class="steps">
      {steps.map((s, i) => (
        <div class="step">
          <div class="marker">{i + 1}</div>
          <div><h3>{s.title}</h3><p>{s.desc}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section { padding: 70px 0; }
  .section-head { max-width: 560px; margin-bottom: 44px; }
  .section-head h2 { font-size: 30px; margin: 0 0 12px; }
  .section-head p { color: var(--text-dim); font-size: 16px; margin: 0; }
  .steps { display: flex; flex-direction: column; }
  .step { display: grid; grid-template-columns: 44px 1fr; gap: 20px; padding: 26px 0; border-bottom: 1px solid var(--border); }
  .step:last-child { border-bottom: none; }
  .step .marker {
    width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft);
    border: 1px solid rgba(16,185,129,0.25); display: flex; align-items: center; justify-content: center;
    color: var(--accent); font-weight: 600; font-family: 'Space Grotesk', sans-serif;
  }
  .step h3 { margin: 0 0 6px; font-size: 17px; }
  .step p { margin: 0; color: var(--text-dim); font-size: 14px; }
</style>
