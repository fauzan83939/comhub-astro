---
---
<section id="join">
  <div class="wrap">
    <div class="cta-band">
      <h2>Ready to jump in?</h2>
      <p>It takes less than a minute to become part of the Rialo community.</p>
      <a class="btn-primary" href="#">Join the Hub</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div>© 2026 Rialo Community Hub</div>
    <div>Built by the community, for the community</div>
  </div>
</footer>

<style>
  section { padding: 70px 0; }
  .cta-band {
    background: linear-gradient(180deg, var(--accent-soft), transparent);
    border: 1px solid rgba(16,185,129,0.25); border-radius: 20px; padding: 56px 40px; text-align: center;
  }
  .cta-band h2 { font-size: 30px; margin: 0 0 14px; }
  .cta-band p { color: var(--text-dim); margin: 0 0 28px; }
  .btn-primary { background: var(--accent); color: #04140e; font-weight: 600; padding: 13px 24px; border-radius: 10px; font-size: 15px; }
  footer { border-top: 1px solid var(--border); padding: 40px 0; font-size: 13px; color: var(--text-dim); }
  footer .wrap { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
</style>
