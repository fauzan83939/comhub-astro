---
---
<div id="comi-widget">
  <button id="comi-toggle">💬</button>
  <div id="comi-box" class="hidden">
    <div id="comi-header">
      <div><strong>COMI</strong><span id="comi-status">● Online</span></div>
      <button id="comi-close">✕</button>
    </div>
    <div id="comi-messages">
      <div class="comi-msg bot">Hi! I'm COMI, ComHub's AI assistant. Ask me anything about Rialo & this community!</div>
    </div>
    <div id="comi-quick-replies">
      <button class="comi-chip">How do I join the community?</button>
    </div>
    <div id="comi-input-row">
      <input id="comi-input" type="text" placeholder="Ask COMI anything..." />
      <button id="comi-send">➤</button>
    </div>
  </div>
</div>

<style>
  #comi-widget { position: fixed; bottom: 20px; right: 20px; z-index: 9999; font-family: 'Inter', sans-serif; }
  #comi-toggle { width: 56px; height: 56px; border-radius: 50%; background: var(--accent); color: #04140e; border: none; font-size: 22px; cursor: pointer; box-shadow: 0 8px 24px rgba(16,185,129,0.35); }
  #comi-box { position: fixed; bottom: 90px; right: 20px; width: 320px; max-width: 90vw; height: 480px; max-height: 70vh; background: #0d0f13; border: 1px solid var(--border); border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.5); }
  #comi-box.hidden { display: none; }
  #comi-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; background: rgba(255,255,255,0.03); border-bottom: 1px solid var(--border); }
  #comi-status { font-size: 11px; color: var(--accent); margin-left: 8px; }
  #comi-close { background: none; border: none; color: var(--text); font-size: 16px; cursor: pointer; }
  #comi-messages { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .comi-msg { padding: 9px 13px; border-radius: 12px; font-size: 13px; max-width: 85%; line-height: 1.45; }
  .comi-msg.bot { background: var(--surface); color: var(--text); align-self: flex-start; }
  .comi-msg.user { background: var(--accent); color: #04140e; align-self: flex-end; }
  #comi-quick-replies { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 14px 10px; }
  .comi-chip { background: transparent; border: 1px solid rgba(16,185,129,0.4); color: var(--accent); padding: 7px 12px; border-radius: 20px; font-size: 12px; cursor: pointer; }
  #comi-input-row { display: flex; padding: 12px; border-top: 1px solid var(--border); gap: 8px; }
  #comi-input { flex: 1; background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 9px 14px; color: var(--text); font-size: 13px; outline: none; }
  #comi-send { background: var(--accent); border: none; color: #04140e; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; }
</style>

<script>
  const toggle = document.getElementById('comi-toggle');
  const box = document.getElementById('comi-box');
  const closeBtn = document.getElementById('comi-close');
  const messages = document.getElementById('comi-messages');
  const input = document.getElementById('comi-input');
  const sendBtn = document.getElementById('comi-send');
  const chips = document.querySelectorAll('.comi-chip');
  let history: { role: string; parts: { text: string }[] }[] = [];

  toggle.onclick = () => box.classList.toggle('hidden');
  closeBtn.onclick = () => box.classList.add('hidden');

  function addMessage(text: string, sender: string) {
    const div = document.createElement('div');
    div.className = `comi-msg ${sender}`;
    div.textContent = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  async function sendMessage(text: string) {
    if (!text.trim()) return;
    addMessage(text, 'user');
    input.value = '';

    const typingDiv = document.createElement('div');
    typingDiv.className = 'comi-msg bot';
    typingDiv.textContent = '...';
    messages.appendChild(typingDiv);
    messages.scrollTop = messages.scrollHeight;

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, history })
      });
      const data = await res.json();
      typingDiv.remove();
      addMessage(data.reply, 'bot');
      history.push({ role: 'user', parts: [{ text }] });
      history.push({ role: 'model', parts: [{ text: data.reply }] });
    } catch (err) {
      typingDiv.remove();
      addMessage('Sorry, a connection error occurred.', 'bot');
    }
  }

  sendBtn.onclick = () => sendMessage(input.value);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') sendMessage(input.value); });
  chips.forEach((chip) => { chip.addEventListener('click', () => sendMessage(chip.textContent || '')); });
</script>
