---
const team = [
  { name: "Community Lead", role: "Organizer", desc: "Keeps activities running and the community connected." },
  { name: "Builder", role: "Site & Tools", desc: "Builds and maintains ComHub itself, including COMI." },
  { name: "Moderator", role: "Community Care", desc: "Makes sure the space stays welcoming for everyone." },
];
---
<section id="team">
  <div class="wrap">
    <div class="section-head">
      <h2>Run by the community</h2>
      <p>ComHub is maintained by community members, for community members.</p>
    </div>
    <div class="team-grid">
      {team.map((t) => (
        <div class="card team-card">
          <div class="avatar"></div>
          <h3>{t.name}</h3>
          <div class="role">{t.role}</div>
          <p>{t.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section { padding: 70px 0; }
  .section-head { max-width: 560px; margin-bottom: 44px; }
  .section-head h2 { font-size: 30px; margin: 0 0 12px; }
  .section-head p { color: var(--text-dim); font-size: 16px; margin: 0; }
  .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 860px) { .team-grid { grid-template-columns: 1fr; } }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 26px; }
  .team-card { text-align: center; padding: 28px 20px; }
  .avatar { width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 14px; background: linear-gradient(135deg, var(--accent), #0891b2); }
  .team-card h3 { font-size: 16px; margin: 0 0 4px; }
  .team-card .role { font-size: 12px; color: var(--accent); margin-bottom: 10px; }
  .team-card p { font-size: 13px; color: var(--text-dim); margin: 0; }
</style>
